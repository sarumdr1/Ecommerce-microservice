# =============================================================================
# .env.example — copy to .env and fill in real values before running anything
# .env is git-ignored and must NEVER be committed
# =============================================================================

# --- Postgres superuser (used only by the init script) -----------------------
POSTGRES_ADMIN_PASSWORD=changeme_postgres_admin

# --- Per-service database passwords ------------------------------------------
# Each service gets its own Postgres user; it can only touch its own database.
IDENTITY_DB_PASSWORD=changeme_identity
CATALOG_DB_PASSWORD=changeme_catalog
CART_DB_PASSWORD=changeme_cart
ORDER_DB_PASSWORD=changeme_order
INVENTORY_DB_PASSWORD=changeme_inventory
PAYMENT_DB_PASSWORD=changeme_payment
NOTIFICATION_DB_PASSWORD=changeme_notification
AGENT_DB_PASSWORD=changeme_agent

# --- Keycloak -----------------------------------------------------------------
KEYCLOAK_DB_PASSWORD=changeme_keycloak_db
KEYCLOAK_ADMIN_PASSWORD=changeme_keycloak_admin
# Dev test users are defined in infra/compose/keycloak/realm/ecommerce-realm.json
#   shopper1 / shopper1pass  — has 'shopper' role
#   admin1   / admin1pass    — has 'admin' role
# These are dev-only credentials; never use them in staging or production.

# --- LLM provider (Phase 2+) -------------------------------------------------
# LLM_API_KEY=sk-...            # Set before Phase 2; never log or commit this
# LLM_MONTHLY_BUDGET_USD=20     # Hard limit enforced in the agent service

# --- Payment stub (Phase 3+) -------------------------------------------------
# PAYMENT_STUB_MODE=approve     # approve | decline | timeout | error_5xx
